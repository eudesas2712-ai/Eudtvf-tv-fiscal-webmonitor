# Exemplo de variáveis de ambiente — TV Fiscal WebMonitor
# Nunca preencher este arquivo com senhas reais em repositório público.

APP_ENV=production
AUTH_ENFORCEMENT_MODE=strict

DATABASE_URL=postgresql+psycopg://usuario:senha@postgres:5432/webmonitor
REDIS_URL=redis://redis:6379/0

ADMIN_TOKEN=troque-este-token
JWT_SECRET_KEY=troque-esta-chave

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=troque-usuario
MINIO_ROOT_PASSWORD=troque-senha
MINIO_BUCKET=evidence
EVIDENCE_PUBLIC_BASE_URL=https://seudominio.com.br/evidence

NEXT_PUBLIC_API_URL=https://seudominio.com.br/api
NEXT_PUBLIC_API_BASE=https://seudominio.com.br/api
NEXT_PUBLIC_ADMIN_TOKEN=

CORS_ORIGINS=https://seudominio.com.br
